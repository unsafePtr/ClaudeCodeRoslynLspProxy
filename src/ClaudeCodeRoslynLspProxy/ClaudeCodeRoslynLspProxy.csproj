<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>ClaudeCodeRoslynLspProxy</RootNamespace>
    <AssemblyName>ClaudeCodeRoslynLspProxy</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <PropertyGroup>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>ClaudeCodeRoslynLspProxy</ToolCommandName>
    <PackageId>ClaudeCodeRoslynLspProxy</PackageId>
    <Version>0.2.0</Version>
    <Authors>unsafePtr</Authors>
    <Description>Thin LSP proxy that injects Roslyn's solution/open notification so Microsoft.CodeAnalysis.LanguageServer works as a solution-aware C# language server inside Claude Code.</Description>
    <PackageTags>claude-code;lsp;roslyn;csharp;dotnet;language-server</PackageTags>
    <PackageProjectUrl>https://github.com/unsafePtr/ClaudeCodeRoslynLspProxy</PackageProjectUrl>
    <RepositoryUrl>https://github.com/unsafePtr/ClaudeCodeRoslynLspProxy</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ClaudeCodeRoslynLspProxy.Tests" />
  </ItemGroup>

</Project>
